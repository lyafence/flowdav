# Ignore all JSON files (configs with secrets)
*.json

# Except example configs
!*example.json

# BUT: test configs with REAL keys must NEVER be in git
# Run scripts/prepare_test_env.sh to generate them with fresh keys.

# Ignore token files
*.token
credentials.json
.env

# Binaries and temp files
bin/
# server
# client
flowdav-client
flowdav-server
flowdav-encrypt
*.tmp
*~
.DS_Store
*.zip
*.tar.gz
*.exe
*.log
.test

# Build artifacts
release/
