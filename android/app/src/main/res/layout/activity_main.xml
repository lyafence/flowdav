<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="TooManyViews">

    <!-- ===== Status Bar (pinned: must stay visible while scrolling) ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/screen_padding"
        android:paddingEnd="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/statusDot"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/status_dot_stopped"
                android:importantForAccessibility="no" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/connectingProgress"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="12dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="?attr/colorTertiary"
                app:trackThickness="3dp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityLiveRegion="polite"
                android:text="@string/status_stopped"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall.Emphasized" />

            <ImageButton
                android:id="@+id/infoButton"
                style="@style/Widget.Flowdav.IconButton"
                android:contentDescription="@string/how_to_use"
                android:src="@drawable/ic_info"
                android:tooltipText="@string/how_to_use" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusDetailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginTop="2dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/contentScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/screen_padding">

            <!-- ===== Mode Toggle ===== -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/modeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:checkedButton="@id/modeFile"
                app:selectionRequired="true"
                app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeFile"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/mode_file"
                app:icon="@drawable/ic_config_file" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/modeManual"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/mode_manual"
                app:icon="@drawable/ic_mode_edit" />

        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- ===== Config file ===== -->
        <LinearLayout
            android:id="@+id/fileSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.chip.Chip
                    android:id="@+id/configChip"
                    style="@style/Widget.Material3.Chip.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checkable="false"
                    android:contentDescription="@string/select_file"
                    android:ellipsize="end"
                    android:maxLines="1"
                    app:checkedIconVisible="false"
                    app:chipBackgroundColor="?attr/colorSurfaceContainerHigh"
                    app:chipEndPadding="12dp"
                    app:chipIconVisible="false"
                    app:chipStartPadding="12dp"
                    app:closeIconTint="?attr/colorOnSurfaceVariant"
                    app:closeIconVisible="false" />

                <ImageButton
                    android:id="@+id/scanQrButton"
                    style="@style/Widget.Flowdav.IconButton"
                    android:layout_marginStart="@dimen/item_gap"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="@string/scan_qr"
                    android:src="@drawable/ic_qr"
                    android:tooltipText="@string/scan_qr" />

            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="@string/master_password"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:importantForAutofill="no"
                    android:saveEnabled="false" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ===== Manual config ===== -->
        <LinearLayout
            android:id="@+id/manualSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="0dp"
                    android:text="@string/section_webdav"
                    android:textAppearance="@style/TextAppearance.Flowdav.SectionHeader"
                    android:accessibilityHeading="true"
                    tools:ignore="UnusedAttribute"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/webdavUrlLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/webdav_url">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/webdavUrlInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textUri"
                        android:saveEnabled="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/webdavLoginLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/webdav_login">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/webdavLoginInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:autofillHints="username"
                        android:saveEnabled="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/webdavTokenLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/webdav_token"
                    app:endIconMode="password_toggle">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/webdavTokenInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:autofillHints="password"
                        android:saveEnabled="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/card_padding"
                    android:paddingEnd="0dp"
                    android:text="@string/section_encryption_keys"
                    android:textAppearance="@style/TextAppearance.Flowdav.SectionHeader"
                    android:accessibilityHeading="true"
                    tools:ignore="UnusedAttribute"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="12dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/encKeyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/enc_key"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_paste"
                    app:endIconContentDescription="@string/paste_desc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/encKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:saveEnabled="false" />

                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/hmacKeyLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:hint="@string/hmac_key"
                    app:endIconMode="custom"
                    app:endIconDrawable="@drawable/ic_paste"
                    app:endIconContentDescription="@string/paste_desc">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/hmacKeyInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textVisiblePassword|textNoSuggestions"
                        android:importantForAutofill="no"
                        android:saveEnabled="false" />

                </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- ===== Advanced settings ===== -->
        <LinearLayout
            android:id="@+id/advancedHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_gap"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:minHeight="56dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="0dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/advanced"
                    tools:ignore="UnusedAttribute"
                    android:textAppearance="@style/TextAppearance.Flowdav.SectionHeader" />

                <TextView
                    android:id="@+id/advancedSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <ImageView
                android:id="@+id/advancedArrow"
                style="@style/Widget.Flowdav.IconButton"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_expand_more" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/advancedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/listenAddrLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/listen_addr">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/listenAddrInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:paddingStart="@dimen/card_padding"
                android:paddingEnd="0dp"
                android:text="@string/section_socks5_auth"
                android:textAppearance="@style/TextAppearance.Flowdav.SectionHeader"
                tools:ignore="UnusedAttribute" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/socks5UserLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/socks5_user">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/socks5UserInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="username"
                    android:saveEnabled="false"
                    android:inputType="text" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/socks5PassLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/socks5_pass"
                app:endIconMode="password_toggle">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/socks5PassInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:autofillHints="password"
                    android:inputType="textPassword"
                    android:saveEnabled="false" />

            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/bootSwitch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:text="@string/boot_autostart" />

            <TextView
                android:id="@+id/forgetPasswordBtn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:minHeight="48dp"
                android:text="@string/forget_password"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

        </LinearLayout>

        <!-- ===== Dashboard ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/dashboard"
            style="?attr/materialCardViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/address_label"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/addrValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:contentDescription="@string/address_label"
                            android:fontFamily="monospace"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurface" />

                        <TextView
                            android:id="@+id/addressHint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/address_hint"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/copyAddrButton"
                        style="@style/Widget.Flowdav.IconButton"
                        android:contentDescription="@string/copy_address"
                        android:src="@drawable/ic_copy" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />

                <TextView
                    android:id="@+id/backendText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:visibility="gone" />

                <com.google.android.material.divider.MaterialDivider
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_gap"
                    android:layout_marginBottom="@dimen/section_gap"
                    app:dividerColor="?attr/colorOutlineVariant" />

                <!-- Connection: headline + supporting text, trailing action.
                     Status icon rides inside the supporting text so the text
                     column stays on the card's 16dp content axis. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/connection"
                            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/testStatusText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:accessibilityLiveRegion="polite"
                            android:gravity="center_vertical"
                            android:text="@string/connection_not_tested"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/testDetailText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="?attr/textAppearanceBodySmall"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/testConnectionButton"
                        style="@style/Widget.Flowdav.IconButton"
                        android:contentDescription="@string/test_connection"
                        android:src="@drawable/ic_refresh"
                        android:tooltipText="@string/test_connection" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Diagnostics ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logSection"
            style="?attr/materialCardViewStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_gap"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:id="@+id/logHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="48dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:text="@string/logs_label"
                        android:textAppearance="@style/TextAppearance.Flowdav.SectionHeader"
                        tools:ignore="UnusedAttribute" />

                    <ImageButton
                        android:id="@+id/copyLogsBtn"
                        style="@style/Widget.Flowdav.IconButton"
                        android:contentDescription="@string/copy_logs"
                        android:src="@drawable/ic_copy" />

                    <ImageView
                        android:id="@+id/logArrow"
                        style="@style/Widget.Flowdav.IconButton"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_expand_more" />
                </LinearLayout>

                <TextView
                    android:id="@+id/logText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@drawable/bg_log_console"
                    android:fontFamily="monospace"
                    android:gravity="start"
                    android:padding="12dp"
                    android:lineSpacingExtra="@dimen/log_line_spacing"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textIsSelectable="true"
                    android:visibility="gone" />
            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


            </LinearLayout>

</ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding">

        <TextView
            android:id="@+id/startHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:visibility="gone" />

        <Button
            android:id="@+id/actionButton"
            style="?attr/materialButtonStyle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/start_proxy"
            android:textAppearance="?attr/textAppearanceLabelLarge" />

    </LinearLayout>

</LinearLayout>
