  "enc_key": "PasteYour32ByteBase64EncodedAES256KeyHere==",
  "hmac_key": "PasteYour32ByteBase64EncodedHMACSHA256KeyHere==",
  "refresh_rate_ms": 500,
  "flush_rate_ms": 500,
  "log_level": "info",
  "health_port": "127.0.0.1:9190"
}
