{
  "listen_addr": "127.0.0.1:1080",
  "storage_type": "webdav",
  "webdav": {
    "provider": "custom",
    "url": "https://your-webdav-server:8080",
    "login": "username",
    "token": "password",
    "base_path": "data_sync"
